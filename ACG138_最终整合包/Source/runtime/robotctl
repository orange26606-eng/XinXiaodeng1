#!/bin/sh
set -u
APP=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
: "${ROBOT_RUN_DIR:=/run/acg138-final-auto-nearstop-app}"
: "${ACG_PHONE_DIR:=/run/acg138-final-auto-nearstop-sensors}"
: "${PHONE_RUN_DIR:=/run/acg138-final-auto-nearstop-phone}"
: "${LIDAR_DEVICE:=/dev/ttyUSB0}"
: "${ROBOT_OUTPUT:=HDMI-A-2}"
: "${ROBOT_FPGA_IFACE:=}"
: "${ROBOT_NAV_MODE:=preview}"
case "$ROBOT_NAV_MODE" in preview|drive) export ACG_LIDAR_CRUISE=0;;cruise) export ACG_LIDAR_CRUISE=1;;*) echo 'ROBOT_NAV_MODE must be preview, drive or cruise' >&2;exit 2;;esac
export ACG_PHONE_DIR PHONE_RUN_DIR LIDAR_DEVICE ROBOT_OUTPUT ROBOT_NAV_MODE
export ACG_APRILTAG_CONFIG=${ACG_APRILTAG_CONFIG:-"$APP/apriltag.conf"}
export ACG_VISION_FRAME="$ACG_PHONE_DIR/vision-frame.bin"
export ACG_OBJECT_FRAME="$ACG_PHONE_DIR/objects-frame.bin"
export ACG_OBJECT_RAW_FRAME="$ACG_PHONE_DIR/objects-raw-frame.bin"
# 分别记录所选模型文件版本和解码格式。
: "${ACG_YOLO_PROFILE:=custom6-new}"
ACG_MODEL_VARIANT=$ACG_YOLO_PROFILE
case "$ACG_MODEL_VARIANT" in
 coco80) export MODEL_PATH="$APP/model/yolo11s-int8-rk3588.rknn";unset ACG_OBJECT_CLASSES_FILE;;
 custom6) export MODEL_PATH="$APP/model/yolo11n-custom6-rk3588.rknn" ACG_OBJECT_CLASSES_FILE="$APP/model/classes-custom6.txt";export LD_LIBRARY_PATH="$APP/model/custom6-lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}";;
 custom6-new) export MODEL_PATH="$APP/model/personnew-int8.rknn" ACG_OBJECT_CLASSES_FILE="$APP/model/classes-custom6.txt";;
 custom6-new-fp16) export MODEL_PATH="$APP/model/personnew-fp16.rknn" ACG_OBJECT_CLASSES_FILE="$APP/model/classes-custom6.txt";ACG_YOLO_PROFILE=custom6-new;;
 *) echo 'ACG_YOLO_PROFILE must be custom6-new, custom6-new-fp16, custom6 or coco80' >&2;exit 2;;
esac
export ACG_YOLO_PROFILE ACG_MODEL_VARIANT
if [ -r "$MODEL_PATH" ];then
 ACG_MODEL_SHA256=$(sha256sum "$MODEL_PATH" | awk '{print $1}')
 export ACG_MODEL_SHA256
fi
export ACG_OBJECTS_CONFIG=${ACG_OBJECTS_CONFIG:-"$APP/objects.conf"}
export ACG_OBJECT_LIDAR_CONFIG=${ACG_OBJECT_LIDAR_CONFIG:-"$APP/object-lidar.conf"}
export ACG_AUTO_CAPABLE=1
: "${ACG_S5_LOG_DIR:=$APP/persistent-logs}"
export ACG_S5_LOG_DIR
if [ -r "$APP/FPGA_SHA256.txt" ];then
 read -r ACG_S5_FS_SHA256 ignored_fs_name < "$APP/FPGA_SHA256.txt" || :
 case "${ACG_S5_FS_SHA256:-}" in *[!0-9a-fA-F]*|'') unset ACG_S5_FS_SHA256;;*) [ "${#ACG_S5_FS_SHA256}" -ne 64 ] || export ACG_S5_FS_SHA256;;esac
fi
LOCK=$ROBOT_RUN_DIR/lock
birth(){ [ -r "/proc/$1/stat" ] || return 1;sed 's/^.*) //' "/proc/$1/stat" | awk '$1 != "Z" {print $20}'; }
record(){ stamp=$(birth "$1") || return 1;[ -n "$stamp" ] || return 1;printf '%s %s\n' "$1" "$stamp" > "$2"; }
alive(){
 [ -r "$1" ] || return 1;read -r saved_pid saved_birth < "$1" || return 1
 case $saved_pid:$saved_birth in *[!0-9:]*|:*|*:) return 1;;esac
 [ "$saved_pid" -gt 1 ] && [ "$(birth "$saved_pid" 2>/dev/null || :)" = "$saved_birth" ] && kill -0 "$saved_pid" 2>/dev/null
}
rotate_one_log(){
  rotate_file=$1;rotate_module=$2
  [ -f "$rotate_file" ] && [ ! -L "$rotate_file" ] || return 0
  rotate_bytes=$(wc -c < "$rotate_file" 2>/dev/null || printf 0)
  case "$rotate_bytes" in *[!0-9]*|'') return 0;;esac
  [ "$rotate_bytes" -ge 2097152 ] || return 0
  [ ! -f "$rotate_file.1" ] || mv -f "$rotate_file.1" "$rotate_file.2"
  if cp "$rotate_file" "$rotate_file.1.tmp" && mv -f "$rotate_file.1.tmp" "$rotate_file.1";then
   : > "$rotate_file"
   printf 'LOG_ROTATED module=%s bytes=%s capacity_bytes=2097152 backups=2 message_zh=原进程继续写入同一文件描述符\n' "$rotate_module" "$rotate_bytes" >> "$rotate_file"
  fi
}
rotate_module_logs(){
 for rotate_name in sensor objects map phone;do
  rotate_one_log "$ROBOT_RUN_DIR/$rotate_name.log" "$rotate_name"
 done
 if [ -r "$ROBOT_RUN_DIR/map.log" ];then
  rotate_session=$(sed -n 's/^Logs: //p' "$ROBOT_RUN_DIR/map.log" | tail -n 1)
  case "$rotate_session" in
   /tmp/acg138-final-auto-nearstop.*)
    case "$rotate_session" in *'/../'*|*'/./'*) return 0;;esac
    rotate_one_log "$rotate_session/navigation.log" navigation
    rotate_one_log "$rotate_session/lidar.log" lidar;;
  esac
 fi
}
persist_event(){
 [ ! -x "$APP/s5-manager-event" ] || "$APP/s5-manager-event" "$1" "$2" "$3" || echo 'S5_MANAGER_LOG_UNAVAILABLE' >&2
}
exit_event(){
 exit_file=$1;exit_module=$2
 if [ -r "$exit_file" ] && ! alive "$exit_file";then
  read -r exit_pid exit_birth < "$exit_file" || return
  case $exit_pid in *[!0-9]*|'') return;;esac
  exit_code=0;wait "$exit_pid" 2>/dev/null || exit_code=$?
  [ "$exit_code" -ne 127 ] || exit_code=-1
  persist_event CHILD_EXIT "$exit_module" "$exit_code"
  if [ "$exit_module" = MAP ];then
   map_failures=$((map_failures+1))
   if [ "$map_failures" -eq 1 ];then map_retry=1;else map_retry=5;fi
   printf 'MAP_RETRY delay_s=%s failures=%s old_commands_replayed=0 message_zh=地图异常自动重启，保留手机服务\n' "$map_retry" "$map_failures"
  fi
  rm -f "$exit_file"
 fi
}
phase(){
 prior_phase=$(cat "$ROBOT_RUN_DIR/phase" 2>/dev/null || :)
 if [ "$prior_phase" != "$*" ];then
  phase_key=${1%% *};persist_event SUPERVISOR_PHASE "$phase_key" -1
 fi
 printf '%s\n' "$*" > "$ROBOT_RUN_DIR/phase.tmp";mv "$ROBOT_RUN_DIR/phase.tmp" "$ROBOT_RUN_DIR/phase"; }
stop_owned(){ if alive "$1";then kill -TERM "$saved_pid" 2>/dev/null || :;fi; }
wait_owned(){ file=$1;remaining=$2;while alive "$file";do [ "$remaining" -gt 0 ] || return 1;sleep 1;remaining=$((remaining-1));done; }
prepare_fpga_link(){
 ROBOT_FPGA_IFACE=${ROBOT_FPGA_IFACE:-eth0}
 sh "$APP/setup-fpga-link.sh" "$ROBOT_FPGA_IFACE" || return 1
 export PHONE_FPGA_IFACE="$ROBOT_FPGA_IFACE" NAV_INTERFACE="$ROBOT_FPGA_IFACE"
}
status(){
 if alive "$ROBOT_RUN_DIR/manager.pid";then echo '管理器：运行中';else echo '管理器：未运行';fi
 if [ -r "$ROBOT_RUN_DIR/phase" ];then printf '阶段：';cat "$ROBOT_RUN_DIR/phase";fi
 sensor_up=0;map_up=0
 for item in sensor phone objects map;do
  if alive "$ROBOT_RUN_DIR/$item.pid";then echo "$item：进程运行中";[ "$item" != sensor ] || sensor_up=1;[ "$item" != map ] || map_up=1
  else echo "$item：未运行";fi
 done
 if [ "$sensor_up" = 0 ] && command -v ss >/dev/null 2>&1 && ss -lun 2>/dev/null | grep -q ':5016[[:space:]]';then echo 'UDP 5016 已由未受此管理器管理的进程占用。';fi
 if [ "$sensor_up" = 0 ] && command -v ss >/dev/null 2>&1 && ss -lun 2>/dev/null | grep -q ':5017[[:space:]]';then echo 'UDP 5017 姿态端口已有其他接收者；查看sensor.log中的绑定原因。';fi
 if [ ! -r "$ROBOT_RUN_DIR/phone.pid" ] && [ -d "$PHONE_RUN_DIR/lock" ];then echo '检测到其他手机摄像头会话或残留锁；需要在原会话中停止或检查。';fi
 if [ "$map_up" = 0 ] && [ -c "$LIDAR_DEVICE" ] && command -v fuser >/dev/null 2>&1 && fuser "$LIDAR_DEVICE" >/dev/null 2>&1;then echo "雷达串口 $LIDAR_DEVICE 已被其他进程占用。";fi
 if [ "$sensor_up" = 1 ] && [ -r "$ACG_PHONE_DIR/mpu9250.snapshot" ];then "$APP/lab-mpu9250-info" --snapshot "$ACG_PHONE_DIR/mpu9250.snapshot" 2>/dev/null | head -n 1 || :;fi
 if [ -r "$ROBOT_RUN_DIR/map.log" ];then
  logdir=$(sed -n 's/^Logs: //p' "$ROBOT_RUN_DIR/map.log" | tail -n 1)
  if [ -n "$logdir" ];then printf '最近地图日志：%s\n' "$logdir";if [ "$map_up" = 1 ] && [ -r "$logdir/navigation.log" ];then grep 'mode=' "$logdir/navigation.log" | tail -n 1 || :;fi;fi
 fi
 ip -o -4 addr show dev wlan0 scope global 2>/dev/null | awk '$3=="inet" {split($4,a,"/");print "Wi-Fi 地址：" a[1] ":8080"}' || :
 printf '管理日志：%s\n' "$ROBOT_RUN_DIR"
 if [ -r "$ACG_PHONE_DIR/apriltag.json" ];then printf '标记状态（兼容接口）：';cat "$ACG_PHONE_DIR/apriltag.json";printf '\n';fi
 printf 'S5持久诊断：%s（导航/phone/manager各2×2MiB，总上限12MiB，未标定参数为假设）\n' "$ACG_S5_LOG_DIR"
 echo '注意：进程运行不等于定位有效或车轮已停止。'
}
cleanup(){
 rc=$?;previous=$(cat "$ROBOT_RUN_DIR/phase" 2>/dev/null || printf UNKNOWN);failed=0
 trap - EXIT INT TERM HUP
 phase STOPPING
 # 等待可选模块退出之前，先撤销手机输入，
 # 两级管理器各自保留最终STOP及有界子进程清理流程。
 stop_owned "$PHONE_RUN_DIR/server.pid"
 stop_owned "$ROBOT_RUN_DIR/phone.pid"
 stop_owned "$ROBOT_RUN_DIR/map.pid";wait_owned "$ROBOT_RUN_DIR/map.pid" 25 || { echo MAP_STOP_TIMEOUT >&2;failed=1; }
 stop_owned "$ROBOT_RUN_DIR/objects.pid";wait_owned "$ROBOT_RUN_DIR/objects.pid" 10 || { echo OBJECTS_STOP_TIMEOUT >&2;failed=1; }
 stop_owned "$ROBOT_RUN_DIR/vision.pid";wait_owned "$ROBOT_RUN_DIR/vision.pid" 10 || { echo VISION_STOP_TIMEOUT >&2;failed=1; }
 if alive "$ROBOT_RUN_DIR/phone.pid";then
  (cd "$APP" && sh begin-phone stop) >> "$ROBOT_RUN_DIR/phone-stop.log" 2>&1 || { echo PHONE_STOP_FAILED >&2;failed=1; }
 fi
 stop_owned "$ROBOT_RUN_DIR/phone.pid";wait_owned "$ROBOT_RUN_DIR/phone.pid" 30 || { echo PHONE_PTY_STOP_TIMEOUT >&2;failed=1; }
 stop_owned "$ROBOT_RUN_DIR/sensor.pid";wait_owned "$ROBOT_RUN_DIR/sensor.pid" 10 || { echo SENSOR_STOP_TIMEOUT >&2;failed=1; }
 if [ "$failed" -ne 0 ];then
  phase "STOP_FAILED previous=$previous";echo 'Cleanup incomplete; keeping PID records and lock for inspection.' >&2
  rm -f "$ROBOT_RUN_DIR/manager.pid";return
 fi
 if [ "$rc" -eq 0 ];then phase STOPPED;else phase "FAILED exit=$rc during=$previous";fi
 rm -f "$ROBOT_RUN_DIR/sensor.pid" "$ROBOT_RUN_DIR/phone.pid" "$ROBOT_RUN_DIR/vision.pid" "$ROBOT_RUN_DIR/objects.pid" "$ROBOT_RUN_DIR/map.pid"
 if ! rmdir "$LOCK" 2>/dev/null;then phase STOP_FAILED_LOCK;echo 'Could not release manager lock.' >&2;fi
 rm -f "$ROBOT_RUN_DIR/manager.pid"
}
run_manager(){
 trap 'exit 0' TERM INT;trap '' HUP;trap cleanup EXIT
 mkdir -p "$ACG_S5_LOG_DIR" || echo S5_MANAGER_LOG_DIRECTORY_FAILED >&2
 printf "MODEL_CONTEXT variant=%s decoder_profile=%s file=%s sha256=%s imu_attitude_source=%s message_zh=使用实际模型文件摘要和解算来源\n" "$ACG_MODEL_VARIANT" "$ACG_YOLO_PROFILE" "$MODEL_PATH" "${ACG_MODEL_SHA256:-UNAVAILABLE}" "${IMU_ATTITUDE_SOURCE:-auto}"
 printf "BUILD_CONTEXT project=%s mode=%s fpga_cfg=0x31110301 nav_ttl_ms=500 output=%s lidar=%s run_dir=%s\n" "$APP" "$ROBOT_NAV_MODE" "$ROBOT_OUTPUT" "$LIDAR_DEVICE" "$ROBOT_RUN_DIR"
 [ ! -r "$APP/diagnostic-policy.json" ] || cat "$APP/diagnostic-policy.json"
 chmod 700 "$ACG_S5_LOG_DIR" 2>/dev/null || :
 mkdir -p "$ACG_PHONE_DIR";chmod 700 "$ACG_PHONE_DIR"
 rm -f "$ACG_PHONE_DIR/apriltag.json" "$ACG_PHONE_DIR/vision-frame.bin" "$ACG_PHONE_DIR/vision-frame.bin.tmp" "$ACG_PHONE_DIR/navigation-motion.json"
 rm -f "$ACG_PHONE_DIR/objects-detections.json" "$ACG_PHONE_DIR/mode-state.json" "$ACG_PHONE_DIR/objects-frame.bin" "$ACG_PHONE_DIR/objects-frame.bin.tmp" "$ACG_PHONE_DIR/objects-state.json" "$ACG_PHONE_DIR/objects-snapshot.json" "$ACG_PHONE_DIR/objects-select.json" "$ACG_PHONE_DIR/objects-map.json" "$ACG_PHONE_DIR/objects-association.json" "$ACG_PHONE_DIR/objects-association-snapshot.json"
 export CAMERA_IMU_OUTPUT="$ROBOT_OUTPUT"
 phase STARTING_PHONE
 if [ -d "$PHONE_RUN_DIR/lock" ] || alive "$PHONE_RUN_DIR/owner.pid";then echo 'Existing phone session: stop it first.' >&2;exit 1;fi
 rm -f "$PHONE_RUN_DIR/ready"
 /bin/sh "$APP/begin-phone" >> "$ROBOT_RUN_DIR/phone.log" 2>&1 & phone=$!
 record "$phone" "$ROBOT_RUN_DIR/phone.pid" || { echo PHONE_START_FAILED >&2;exit 1; }
 i=0;while [ ! -f "$PHONE_RUN_DIR/ready" ];do
  alive "$ROBOT_RUN_DIR/phone.pid" || { echo 'Phone/camera launcher exited; inspect phone.log' >&2;exit 1; }
  [ "$i" -lt 20 ] || { echo 'Independent phone API startup timeout' >&2;exit 1; };sleep 1;i=$((i+1))
 done
 phase RUNNING_MANUAL_MODULES_STARTING
 sensor_retry=0;map_retry=0;map_failures=0;objects_retry=0
 while :;do
  rotate_module_logs
  for log_module in sensor objects map phone;do
   exit_event "$ROBOT_RUN_DIR/$log_module.pid" "$(printf '%s' "$log_module" | tr '[:lower:]' '[:upper:]')"
  done
  # 感知模块供导航使用，运行中的手动控制接口不依赖它们，
  # 只重试当前管理器所属且已失败的子进程。
  if ! alive "$ROBOT_RUN_DIR/sensor.pid" && [ "$sensor_retry" -le 0 ];then
   if [ -x "$APP/lab-mpu9250-service" ];then
    "$APP/lab-mpu9250-service" --run --odom-config "$APP/odometry.conf" --imu-config "$APP/mpu9250.conf" --attitude-source "${IMU_ATTITUDE_SOURCE:-auto}" --state-dir "$ACG_PHONE_DIR" >> "$ROBOT_RUN_DIR/sensor.log" 2>&1 & sensor=$!
    record "$sensor" "$ROBOT_RUN_DIR/sensor.pid" || echo SENSOR_START_FAILED >&2
   fi
   sensor_retry=5
  fi
  if ! alive "$ROBOT_RUN_DIR/objects.pid" && [ "$objects_retry" -le 0 ];then
   if [ -x "$APP/acg138-objects" ] && [ -r "$ACG_OBJECTS_CONFIG" ];then
    "$APP/acg138-objects" --config "$ACG_OBJECTS_CONFIG" --frame "$ACG_OBJECT_FRAME" --raw-frame "$ACG_OBJECT_RAW_FRAME" --state "$ACG_PHONE_DIR/objects-state.json" --snapshot "$ACG_PHONE_DIR/objects-snapshot.json" --selection "$ACG_PHONE_DIR/objects-select.json" >> "$ROBOT_RUN_DIR/objects.log" 2>&1 & objects=$!
    record "$objects" "$ROBOT_RUN_DIR/objects.pid" || echo OBJECTS_START_FAILED >&2
   fi
   objects_retry=5
  fi
  sensor_ready=0;display_ready=0
  if alive "$ROBOT_RUN_DIR/sensor.pid" && [ -x "$APP/lab-mpu9250-info" ];then
   if "$APP/lab-mpu9250-info" --snapshot "$ACG_PHONE_DIR/mpu9250.snapshot" 2>/dev/null | grep -q 'state=READY';then sensor_ready=1;fi
  fi
  case ${WAYLAND_DISPLAY:-wayland-0} in /*) display_socket=$WAYLAND_DISPLAY;;*) display_socket=${XDG_RUNTIME_DIR:-/run}/${WAYLAND_DISPLAY:-wayland-0};;esac
  [ ! -S "$display_socket" ] || display_ready=1
  if ! alive "$ROBOT_RUN_DIR/map.pid" && [ "$map_retry" -le 0 ] && [ "$sensor_ready" = 1 ] && [ -c "$LIDAR_DEVICE" ] && [ "$display_ready" = 1 ] && ! { command -v fuser >/dev/null 2>&1 && fuser "$LIDAR_DEVICE" >/dev/null 2>&1; };then
   if [ -x "$APP/nav/live-map-nav-panel" ] && [ -x "$APP/map/lidar-usb-timed" ];then
    if [ "$ROBOT_NAV_MODE" != preview ];then
     (cd "$APP" && exec sh nav/run-live-nav --run --output "$ROBOT_OUTPUT" --enable-drive) >> "$ROBOT_RUN_DIR/map.log" 2>&1 & map=$!
    else
     (cd "$APP" && exec sh nav/run-live-nav --run --output "$ROBOT_OUTPUT") >> "$ROBOT_RUN_DIR/map.log" 2>&1 & map=$!
    fi
    record "$map" "$ROBOT_RUN_DIR/map.pid" || echo MAP_START_FAILED >&2
   fi
   map_retry=5
  fi
  if ! alive "$ROBOT_RUN_DIR/phone.pid";then phase DEGRADED_PHONE_STOPPED
  elif [ "$sensor_ready" = 0 ];then phase MANUAL_ONLY_WAIT_SENSOR
  elif [ ! -c "$LIDAR_DEVICE" ];then phase MANUAL_ONLY_WAIT_LIDAR
  elif [ "$display_ready" = 0 ];then phase MANUAL_ONLY_WAIT_WAYLAND
  elif ! alive "$ROBOT_RUN_DIR/map.pid";then phase MANUAL_ONLY_MAP_RETRY
  elif [ "$ROBOT_NAV_MODE" = cruise ];then phase RUNNING_CRUISE_CAPABLE
  elif [ "$ROBOT_NAV_MODE" = drive ];then phase RUNNING_DRIVE_CAPABLE
  else phase RUNNING_PREVIEW;fi
  sleep 1
  [ "$sensor_retry" -le 0 ] || sensor_retry=$((sensor_retry-1))
  [ "$map_retry" -le 0 ] || map_retry=$((map_retry-1))
  [ "$objects_retry" -le 0 ] || objects_retry=$((objects_retry-1))
 done
}
case ${1:-status} in
 start)
  [ "$(id -u)" = 0 ] || { echo '请以 root 启动。' >&2;exit 1; }
  mkdir -p "$ROBOT_RUN_DIR" || exit 1
  if ! mkdir "$LOCK" 2>/dev/null;then echo '已有会话或残留锁，请先执行 sh begin status；不会自动接管。' >&2;exit 1;fi
  if [ -d "$PHONE_RUN_DIR/lock" ] || alive "$PHONE_RUN_DIR/owner.pid";then echo '旧手机摄像头会话仍在运行或锁未清理，请先在原终端停止并检查。' >&2;rmdir "$LOCK";exit 1;fi
  for f in begin-phone startPhoneV7 start-phone-server.sh acg138-phone-server setup-fpga-link.sh check-fpga-link.sh resource-conflict.sh;do
   [ -f "$APP/$f" ] || { echo "缺少 $f" >&2;rmdir "$LOCK";exit 1; }
  done
  if ! sh "$APP/resource-conflict.sh";then rmdir "$LOCK";exit 1;fi
  if ! prepare_fpga_link;then rmdir "$LOCK";exit 1;fi
  for f in robotctl robot-pty s5-manager-event lab-mpu9250-service lab-mpu9250-info acg138-objects nav/live-map-nav-panel map/lidar-usb-timed;do [ ! -f "$APP/$f" ] || chmod u+x "$APP/$f";done
  nohup "$APP/robotctl" _run </dev/null > "$ROBOT_RUN_DIR/manager.log" 2>&1 & manager=$!
  record "$manager" "$ROBOT_RUN_DIR/manager.pid" || { echo '无法记录管理器，请检查日志。' >&2;exit 1; }
  echo '后台启动：先提供独立手动控制；IMU、摄像头和雷达随后启动。执行 sh begin status 查看进度。'
  if [ "$ROBOT_NAV_MODE" = cruise ];then echo '已加载RK雷达巡航能力；需手机明确开始巡航，才会运动。'
  elif [ "$ROBOT_NAV_MODE" = drive ];then echo '已加载自动模式与目标导航能力；首页自动模式或地图开始按钮明确启动，程序不会自行发动。';else echo '默认仅路径预览，不启用导航电机。';fi
  ;;
 _run) run_manager;;
 status) status;;
 stop)
  if alive "$ROBOT_RUN_DIR/manager.pid";then
   kill -TERM "$saved_pid";wait_owned "$ROBOT_RUN_DIR/manager.pid" 135 || { echo '停止超时；请检查日志，不要删除锁。' >&2;exit 1; }
   if [ -d "$LOCK" ];then echo '部分进程未能停止；锁和记录保留，请检查日志。' >&2;exit 1;fi
   echo '管理会话已停止；请确认车轮物理停止。'
  elif [ -d "$LOCK" ];then echo '管理器未运行但锁仍存在；不自动删除，请检查进程和日志。' >&2;exit 1
  else echo '管理会话未运行。';fi;;
 *) echo '用法：sh begin [start|status|stop]' >&2;exit 2;;
esac
